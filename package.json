{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke.mjs",
    "e2e": "node harness/run.mjs",
    "perf": "node harness/run.mjs --perf",
    "ci:usage": "node scripts/ci-usage.mjs",
    "indexnow": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/indexnow.mjs",
    "i18n:pages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-tool-pages.mjs",
    "i18n:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-sync.mjs",
    "i18n:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-i18n.mjs",
    "i18n:huge": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-huge.mjs",
    "wasm": "cd lib/json/wasm && cargo build --release --target-dir ../../../node_modules/.cache/tape-wasm && node -e \"require('fs').copyFileSync('../../../node_modules/.cache/tape-wasm/wasm32-unknown-unknown/release/tape.wasm', '../tape.wasm')\"",
    "wasm:huge": "cd lib/huge/wasm && cargo build --release --target-dir ../../../node_modules/.cache/huge-wasm && node -e \"require('fs').copyFileSync('../../../node_modules/.cache/huge-wasm/wasm32-unknown-unknown/release/huge.wasm', '../huge.wasm')\""
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.2",
    "posthog-js": "1.438.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@posthog/nextjs-config": "1.11.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "1.64.1",
    "typescript": "^5"
  }
}
