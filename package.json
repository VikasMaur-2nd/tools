{
  "name": "tools",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/test.mjs",
    "e2e": "node harness/run.mjs",
    "perf": "node harness/run.mjs --perf",
    "indexnow": "node scripts/indexnow.mjs",
    "i18n:pages": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-tool-pages.mjs",
    "i18n:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/i18n-sync.mjs",
    "i18n:verify": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-i18n.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "next": "16.4.2",
    "posthog-js": "1.438.12",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@posthog/nextjs-config": "1.11.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "playwright-core": "1.64.1",
    "typescript": "^5"
  }
}
