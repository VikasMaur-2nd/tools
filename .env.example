# Copy to .env.local for local work, and add the same variables in Vercel →
# Project → Settings → Environment Variables (Production) for the live site.
# Both are public by design: they end up in the browser bundle. Restart
# `pnpm dev` / rebuild after changing them.

# PostHog → Settings → Project → General → "Project token" (starts with phc_).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# Your PostHog Cloud region's ingestion host. The browser never calls it
# directly: next.config.ts proxies /relay on this site to it.
#   US Cloud: https://us.i.posthog.com
#   EU Cloud: https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: only for self-hosted PostHog (the app URL that opens recordings
# from the toolbar). Derived automatically for US/EU Cloud.
# NEXT_PUBLIC_POSTHOG_UI_HOST=

# Analytics only runs on tools.vikasmaur.com (never on localhost, previews or
# automated browsers). To test locally, run this in the browser console, then
# reload:   localStorage.setItem('jf:analytics', 'debug')
# and remove it afterwards: localStorage.removeItem('jf:analytics')
